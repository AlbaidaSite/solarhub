# Variables de entorno de SolarHub.
# Copia este fichero como `.env.local` y rellena los valores. `.env.local`
# está en .gitignore: nunca subas valores reales al repo.
#
# Las que empiezan por NEXT_PUBLIC_ pueden llegar al navegador; el resto
# son secretos de servidor.
#
# En producción NO se usa este fichero: los valores van en Vercel →
# Settings → Environment Variables (ámbito Production).

# ─── Supabase ────────────────────────────────────────────────────────────
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasea RLS: solo servidor y scripts.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional. Por defecto: solarhub-assets.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=

# ─── Bunny Stream (vídeos de los pins) ───────────────────────────────────
# Stream → (tu library) → API. ID numérico de la Video Library.
BUNNY_STREAM_LIBRARY_ID=
# Stream → (tu library) → API → "API Key" (la de la library, NO la de la cuenta).
BUNNY_STREAM_API_KEY=
# Stream → (tu library) → API → "Read-only API Key". Firma de los webhooks.
BUNNY_STREAM_READONLY_API_KEY=
# Stream → (tu library) → Security → Embed view token authentication → clave.
BUNNY_STREAM_TOKEN_KEY=
# Stream → (tu library) → API → "CDN Hostname", sin https:// ni barra final.
# Ej.: vz-12345678-abc.b-cdn.net. No es un secreto: aparece en la URL de
# cada miniatura.
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=
